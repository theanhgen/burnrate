<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required for Mac App Store -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- Network access for probing AI provider APIs/CLIs -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Apple Events for inter-process communication with CLI tools -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
    <!-- NSOpenPanel: user-granted read/write access to credential folders -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <!-- Persist security-scoped bookmarks across app launches -->
    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>
    <!-- App Groups omitted: burnrate-mas does not embed a widget extension.
         Add back (with registered App Group in Developer Portal) when the MAS
         widget extension target is added. -->
</dict>
</plist>
