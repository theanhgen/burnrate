<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required for Mac App Store -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- Network access for probing AI provider APIs -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Apple Events for inter-process communication -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
    <!-- NSOpenPanel: user-granted read/write access to credential folders -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <!-- Persist security-scoped bookmarks across app launches -->
    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>
    <!-- iCloud / CloudKit for macOS → iOS quota sync -->
    <key>com.apple.developer.icloud-container-identifiers</key>
    <array>
        <string>iCloud.com.nguyentheanh.burnrate</string>
    </array>
    <key>com.apple.developer.icloud-services</key>
    <array>
        <string>CloudKit</string>
    </array>
</dict>
</plist>
